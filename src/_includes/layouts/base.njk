<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo_title or title or site.title }}</title>
  <meta name="description" content="{{ seo_description or description or site.description }}">

  <!-- Canonical — always www -->
  <link rel="canonical" href="https://www.grosbygroup.com{{ page.url }}">

  <!-- hreflang alternates -->
  {% include "partials/hreflang.njk" %}

  <!-- Open Graph -->
  <meta property="og:title"       content="{{ seo_title or title or site.title }}">
  <meta property="og:description" content="{{ seo_description or description or site.description }}">
  <meta property="og:url"         content="https://www.grosbygroup.com{{ page.url }}">
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="Grosby Group">
  {% if og_image %}
  <meta property="og:image"       content="https://www.grosbygroup.com{{ og_image }}">
  {% else %}
  <meta property="og:image"       content="https://www.grosbygroup.com/assets/og-default.jpg">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="{{ seo_title or title or site.title }}">
  <meta name="twitter:description" content="{{ seo_description or description or site.description }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/Grosby_Group_-_Logo_Redondo_-_300x300.png">

  <!-- Fonts (CDN — self-host before launch) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,600;1,400;1,600&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  <!-- Organization JSON-LD (homepage only) -->
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Grosby Group",
    "url": "https://www.grosbygroup.com",
    "logo": "https://www.grosbygroup.com{{ site.logo }}",
    "description": "Latin America's leading image agency. Thirty years licensing the world's best photography to publishers, broadcasters, and brands.",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "hello@grosbygroup.com",
      "contactType": "Customer Service",
      "availableLanguage": ["English", "Spanish", "Portuguese"]
    },
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.instagram }}"
    ]
  }
  </script>
  {% endif %}

  <!-- FAQPage JSON-LD (pages with faq frontmatter array) -->
  {% if faq %}{% include "partials/faq-schema.njk" %}{% endif %}

  <!-- Google Analytics 4 — TODO: guard with environment variable before launch -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GT1MF1TB5R"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GT1MF1TB5R');
  </script>
</head>
<body>

<!-- NAVIGATION -->
<nav class="nav" id="mainNav">
  <div class="nav-inner">

    <a href="/" class="nav-logo" aria-label="Grosby Group — Home">
      <img src="{{ site.logoWhite }}" alt="Grosby Group" id="navLogo" width="160" height="36">
    </a>

    <ul class="nav-links" id="navLinks" role="list">
      <li><a href="/content/"{% if '/content/' in page.url %} class="active"{% endif %}>Content</a></li>
      <li><a href="/publishers/"{% if page.url == '/publishers/' %} class="active"{% endif %}>Publishers</a></li>
      <li><a href="/creators/"{% if page.url == '/creators/' %} class="active"{% endif %}>Creators</a></li>
      <li><a href="/agencies/"{% if page.url == '/agencies/' %} class="active"{% endif %}>Agencies</a></li>
      <li><a href="/about/"{% if page.url == '/about/' %} class="active"{% endif %}>About</a></li>
    </ul>

    <div class="nav-right">
      <nav class="nav-lang" aria-label="Language">
        <a href="/"    class="nav-lang-link{% if not lang or lang == 'en' %} active{% endif %}" hreflang="en"    lang="en"    aria-label="English">EN</a>
        <a href="/es/" class="nav-lang-link{% if lang == 'es' %} active{% endif %}" hreflang="es-419" lang="es" aria-label="Español">ES</a>
        <a href="/pt/" class="nav-lang-link{% if lang == 'pt' %} active{% endif %}" hreflang="pt-BR"  lang="pt" aria-label="Português">PT</a>
      </nav>
      <a href="{{ site.archiveUrl }}" class="btn-primary nav-cta" target="_blank" rel="noopener noreferrer">Get Access</a>
    </div>

    <button class="nav-toggle" id="navToggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>

  </div>
</nav>

<!-- PAGE CONTENT -->
{{ content | safe }}

<!-- FOOTER -->
<footer class="footer">
  <div class="container">

    <div class="footer-top">
      <div class="footer-brand">
        <img src="{{ site.logoWhite }}" alt="Grosby Group" width="160" height="36">
        <p class="footer-tagline">The image agency for Latino media.</p>
        <div class="footer-social">
          <a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Grosby Group on Facebook">Facebook</a>
          <a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Grosby Group on Instagram">Instagram</a>
        </div>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h5>For Publishers</h5>
          <a href="/publishers/">Overview</a>
          <a href="/content/">Content Library</a>
          <a href="/content/celebrity/">Celebrity</a>
          <a href="/content/sports/">Sports</a>
          <a href="/content/archive/">Archive</a>
        </div>
        <div class="footer-col">
          <h5>For Creators</h5>
          <a href="/creators/">Overview</a>
          <a href="/creators/#representation">Representation</a>
          <a href="/creators/#syndication">Syndication</a>
          <a href="/contact/?re=creators">Get in touch</a>
        </div>
        <div class="footer-col">
          <h5>For Agencies</h5>
          <a href="/agencies/">Overview</a>
          <a href="/agencies/#distribution">Distribution</a>
          <a href="/agencies/#partnership">Partnership</a>
          <a href="/contact/?re=agencies">Get in touch</a>
        </div>
        <div class="footer-col">
          <h5>Company</h5>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/legal/">Legal &amp; Privacy</a>
          <a href="{{ site.archiveUrl }}" target="_blank" rel="noopener" class="footer-cta-link">Get Access →</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">&copy; 2026 Grosby Group Inc. All Rights Reserved.</span>
      <a href="/legal/" class="footer-legal-link">Privacy Policy</a>
    </div>

  </div>
</footer>

<script>
// Nav: scroll state
const nav        = document.getElementById('mainNav');
const navToggle  = document.getElementById('navToggle');
const navLinks   = document.getElementById('navLinks');

window.addEventListener('scroll', function() {
  nav.classList.toggle('scrolled', window.scrollY > 60);
}, { passive: true });

// Nav: mobile toggle
navToggle.addEventListener('click', function() {
  var expanded = this.getAttribute('aria-expanded') === 'true';
  this.setAttribute('aria-expanded', String(!expanded));
  navLinks.classList.toggle('open');
  this.classList.toggle('active');
});

// Close mobile nav on link click
navLinks.querySelectorAll('a').forEach(function(link) {
  link.addEventListener('click', function() {
    navLinks.classList.remove('open');
    navToggle.classList.remove('active');
    navToggle.setAttribute('aria-expanded', 'false');
  });
});

// Fade-up animations — honour prefers-reduced-motion
if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(function(el) {
    observer.observe(el);
  });
}
</script>

</body>
</html>
