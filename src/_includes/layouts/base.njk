<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ seo_title or title or site.title }}</title>
  <meta name="description" content="{{ seo_description or description or site.description }}">

  <!-- Canonical — always www -->
  <link rel="canonical" href="https://www.grosbygroup.com{{ page.url }}">

  <!-- hreflang alternates -->
  {% include "partials/hreflang.njk" %}

  <!-- Open Graph -->
  <meta property="og:title"       content="{{ seo_title or title or site.title }}">
  <meta property="og:description" content="{{ seo_description or description or site.description }}">
  <meta property="og:url"         content="https://www.grosbygroup.com{{ page.url }}">
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="Grosby Group">
  {% if og_image %}
  <meta property="og:image"       content="https://www.grosbygroup.com{{ og_image }}">
  {% else %}
  <meta property="og:image"       content="https://www.grosbygroup.com/assets/og-default.jpg">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="{{ seo_title or title or site.title }}">
  <meta name="twitter:description" content="{{ seo_description or description or site.description }}">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/assets/Grosby_Group_-_Logo_Redondo_-_300x300.png">

  <!-- Fonts (CDN — self-host before launch) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,600;1,400;1,600&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  <!-- Organization JSON-LD (homepage only) -->
  {% if page.url == '/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Grosby Group",
    "url": "https://www.grosbygroup.com",
    "logo": "https://www.grosbygroup.com{{ site.logo }}",
    "description": "Boutique editorial image licensing and content syndication agency for the Latin American and US Hispanic market. Thirty years of specialist LatAm editorial representation.",
    "areaServed": ["Latin America", "US Hispanic Market", "Brazil"],
    "sameAs": [
      "https://www.youtube.com/@grosbynews",
      "https://www.instagram.com/grosbynews",
      "https://www.facebook.com/GrosbyNews"
    ]
  }
  </script>
  {% endif %}

  <!-- FAQPage JSON-LD (pages with faq frontmatter array) -->
  {% if faq %}{% include "partials/faq-schema.njk" %}{% endif %}

  <!-- Google Analytics 4 — TODO: guard with environment variable before launch -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GT1MF1TB5R"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GT1MF1TB5R', {
      linker: { domains: ['archive.grosbygroup.com'] }
    });
  </script>
</head>
<body>

<!-- NAVIGATION -->
<nav class="nav" id="mainNav">
  <div class="nav-inner">

    <a href="/" class="nav-logo" aria-label="Grosby Group — Home">
      <img src="{{ site.logoWhite }}" alt="Grosby Group" id="navLogo" width="160" height="36">
    </a>

    <div class="nav-right">
      <ul class="nav-links" id="navLinks" role="list">
        <li><a href="/licensing/"{% if page.url == '/licensing/' %} class="active"{% endif %}>Licensing</a></li>
        <li><a href="/creators/"{% if page.url == '/creators/' %} class="active"{% endif %}>Creators</a></li>
        <li><a href="/syndication/"{% if page.url == '/syndication/' %} class="active"{% endif %}>Syndication</a></li>
        <li><a href="/about/"{% if page.url == '/about/' %} class="active"{% endif %}>About</a></li>
      </ul>
      <div class="nav-lang-globe" id="langSwitcher">
        <button class="nav-lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Select language">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
            <path d="M2 12h20"/>
          </svg>
        </button>
        <ul class="nav-lang-dropdown" role="menu">
          <li role="none"><a href="/"    role="menuitem" hreflang="en"    lang="en"{% if not lang or lang == 'en' %} class="current"{% endif %}>English</a></li>
          <li role="none"><a href="/es/" role="menuitem" hreflang="es-419" lang="es"{% if lang == 'es' %} class="current"{% endif %}>Español</a></li>
          <li role="none"><a href="/pt/" role="menuitem" hreflang="pt-BR"  lang="pt"{% if lang == 'pt' %} class="current"{% endif %}>Português</a></li>
        </ul>
      </div>
      <a href="{{ site.archiveUrl }}" class="btn-primary nav-cta" target="_blank" rel="noopener noreferrer">Get Access</a>
    </div>

    <button class="nav-toggle" id="navToggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="navLinks">
      <span></span><span></span><span></span>
    </button>

  </div>
</nav>

<!-- PAGE CONTENT -->
{{ content | safe }}

<!-- FOOTER -->
<footer class="footer">
  <div class="container">

    <div class="footer-top">
      <div class="footer-brand">
        <img src="{{ site.logoWhite }}" alt="Grosby Group" width="160" height="36">
        <p class="footer-tagline">The image agency for Latino media.</p>
        <div class="footer-social">
          <a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Grosby Group on Facebook">Facebook</a>
          <a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Grosby Group on Instagram">Instagram</a>
        </div>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h5>For Publishers</h5>
          <a href="/licensing/">Overview</a>
          <a href="/partners/">Our Agencies</a>
          <a href="/contact/?re=publisher">Get in touch</a>
        </div>
        <div class="footer-col">
          <h5>For Creators</h5>
          <a href="/creators/">Overview</a>
          <a href="/contact/?re=creators">Get in touch</a>
        </div>
        <div class="footer-col">
          <h5>For Agencies</h5>
          <a href="/syndication/">Overview</a>
          <a href="/contact/?re=agencies">Get in touch</a>
        </div>
        <div class="footer-col">
          <h5>Company</h5>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/legal/">Legal &amp; Privacy</a>
          <a href="{{ site.archiveUrl }}" target="_blank" rel="noopener" class="footer-cta-link">Get Access →</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">&copy; 2026 Grosby Group Inc. All Rights Reserved.</span>
      <a href="/legal/" class="footer-legal-link">Privacy Policy</a>
    </div>

  </div>
</footer>

<script>
const navToggle  = document.getElementById('navToggle');
const navLinks   = document.getElementById('navLinks');

// Nav: mobile toggle
navToggle.addEventListener('click', function() {
  var expanded = this.getAttribute('aria-expanded') === 'true';
  this.setAttribute('aria-expanded', String(!expanded));
  navLinks.classList.toggle('open');
  this.classList.toggle('active');
});

// Close mobile nav on link click
navLinks.querySelectorAll('a').forEach(function(link) {
  link.addEventListener('click', function() {
    navLinks.classList.remove('open');
    navToggle.classList.remove('active');
    navToggle.setAttribute('aria-expanded', 'false');
  });
});

// Language globe dropdown
var langSwitcher = document.getElementById('langSwitcher');
var langBtn      = langSwitcher.querySelector('.nav-lang-btn');
var langDropdown = langSwitcher.querySelector('.nav-lang-dropdown');
langBtn.addEventListener('click', function(e) {
  e.stopPropagation();
  var open = langSwitcher.classList.toggle('open');
  langBtn.setAttribute('aria-expanded', String(open));
});
document.addEventListener('click', function() {
  langSwitcher.classList.remove('open');
  langBtn.setAttribute('aria-expanded', 'false');
});
langDropdown.addEventListener('click', function(e) { e.stopPropagation(); });

// GA4 Custom Events
document.addEventListener('click', function(e) {
  var el = e.target.closest('a, button');
  if (!el) return;
  var href = el.getAttribute('href') || '';
  var text = (el.textContent || '').trim();

  // GET ACCESS clicks
  if (text.match(/get access/i) || el.classList.contains('nav-cta')) {
    gtag('event', 'cta_get_access', { link_url: href });
  }

  // Archive links
  if (href.indexOf('archive.grosbygroup.com') !== -1) {
    gtag('event', 'archive_link_click', { link_url: href });
  }

  // Syndication page CTAs
  if (window.location.pathname === '/syndication/' && el.classList.contains('btn-primary')) {
    gtag('event', 'cta_syndication', { link_text: text });
  }
});

// Contact form submit
var contactForm = document.getElementById('contactForm');
if (contactForm) {
  contactForm.addEventListener('submit', function() {
    var segment = (document.getElementById('enquiryType') || {}).value || 'unknown';
    gtag('event', 'contact_form_submit', { form_segment: segment });
  });
}

// Fade-up animations — honour prefers-reduced-motion
if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.fade-up').forEach(function(el) {
    observer.observe(el);
  });
}
</script>

</body>
</html>
