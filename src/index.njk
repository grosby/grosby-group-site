    <p class="hero-eyebrow">Latin America's Leading Image Agency</p>
    <h1 class="hero-headline">WE HAVE IT.</h1>
    <p class="hero-subhead">Thirty years representing the world's best photographers and delivering editorial content to Latin America's leading publishers.</p>
    <div class="hero-ctas">
      <a href="{{ site.accountUrl }}" class="btn-primary">Open an account</a>
      <a href="/services/" class="btn-ghost">Learn more</a>
    </div>
  </div>
</section>

