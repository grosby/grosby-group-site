<!-- ─────────────────────────────────────────
     SECTION 3: THREE AUDIENCE PATHS
     ───────────────────────────────────────── -->
<section class="audience-paths">
  <div class="audience-paths-intro">
    <div class="section-label section-label--blue">Who We Serve</div>
    <h2>THE RIGHT CONTENT<br>FOR EVERY AUDIENCE</h2>
  </div>
  <div class="audience-grid">

    <a href="/publishers/" class="audience-card fade-up">
      <div class="audience-card__bg">
        {% image images.hero.publishers, "Copa América football match editorial photography", "(max-width: 900px) 100vw, 33vw" %}
      </div>
      <div class="audience-card__content">
        <p class="audience-card__label">For Publishers &amp; Media Buyers</p>
        <h3>THE IMAGES YOUR EDITORS NEED</h3>
        <span class="audience-card-cta">Get Access →</span>
      </div>
    </a>

    <a href="/creators/" class="audience-card fade-up">
      <div class="audience-card__bg">
        {% image images.hero.creators, "Photographer performing on stage with golden stage lights", "(max-width: 900px) 100vw, 33vw" %}
      </div>
      <div class="audience-card__content">
        <p class="audience-card__label">For Creators &amp; Social Media</p>
        <h3>THE FACES YOUR FOLLOWERS RECOGNISE</h3>
        <span class="audience-card-cta">License content →</span>
      </div>
    </a>

    <a href="/agencies/" class="audience-card fade-up">
      <div class="audience-card__bg">
        {% image images.hero.agencies, "Portrait photography — global image agency partner", "(max-width: 900px) 100vw, 33vw" %}
      </div>
      <div class="audience-card__content">
        <p class="audience-card__label">For Photo Agencies</p>
        <h3>YOUR CONTENT. OUR TERRITORY</h3>
        <span class="audience-card-cta">Partner with us →</span>
      </div>
    </a>

  </div>
</section>

<!-- ─────────────────────────────────────────
     SECTION 4: PARTNER NETWORK
     ───────────────────────────────────────── -->
<section class="partners">
  <div class="container--wide">
    <div class="section-label section-label--blue">Some Agencies We Represent</div>
    <h2>OUR GLOBAL PARTNER NETWORK</h2>

    <div class="partners-grid">
      {% for partner in partners %}
      <div class="partner-logo">
        <img src="/assets/partners/{{ partner.logo }}" alt="{{ partner.name }}" loading="lazy">
      </div>
      {% endfor %}
    </div>

    <p class="partners-closing">Grosby Group is the licensing partner for the world's leading photography agencies, connecting global content with the region's most influential publishers, broadcasters, content creators, and brands.</p>
    <p class="partners-network-link"><a href="/partners/">See our full partner network →</a></p>
  </div>
</section>

<!-- ─────────────────────────────────────────
     SECTION 5: CONTENT CATEGORIES
     ───────────────────────────────────────── -->
<section class="categories">
  <div class="container--wide">
    <div class="section-label" style="padding: 0 var(--gutter); max-width: var(--container-max); margin: 0 auto var(--space-3);">Our Content</div>
    <h2 class="categories-heading">WHAT WE COVER </h2>
    <div class="categories-grid">

      <!-- Tile 1: Celebrity — span 2 -->
      <a class="category-tile" href="/content/celebrity/">
        {% image images.categories.celebrity, "Celebrity photography — red carpet", "(max-width: 768px) 100vw, 50vw" %}
        <span class="category-tile-label">Celebrity</span>
      </a>

      <!-- Tile 2: Fashion -->
      <a class="category-tile" href="/content/fashion/">
        {% image images.categories.fashion, "Fashion and street style photography", "(max-width: 768px) 50vw, 25vw" %}
        <span class="category-tile-label">Fashion</span>
      </a>

      <!-- Tile 3: Sports -->
      <a class="category-tile" href="/content/sports/">
        {% image images.categories.sports, "Sports photography — Copa América", "(max-width: 768px) 50vw, 25vw" %}
        <span class="category-tile-label">Sports</span>
      </a>

      <!-- Tile 4: Travel — span 2 -->
      <a class="category-tile" href="/content/travel/">
        {% image images.categories.travel, "Travel photography — Latin America", "(max-width: 768px) 100vw, 50vw" %}
        <span class="category-tile-label">Travel</span>
      </a>

      <!-- Tile 5: Food -->
      <a class="category-tile" href="/content/food/">
        {% image images.categories.food, "Food and recipe photography", "(max-width: 768px) 50vw, 25vw" %}
        <span class="category-tile-label">Food &amp; Recipes</span>
      </a>

      <!-- Tile 6: Editorial -->
      <a class="category-tile" href="/content/editorial/">
        {% image images.categories.editorial, "Editorial and news photography", "(max-width: 768px) 50vw, 25vw" %}
        <span class="category-tile-label">Editorial &amp; News</span>
      </a>

      <!-- Tile 7: Archive — span 4 full width -->
      <a class="category-tile" href="/content/archive/">
        {% image images.categories.archive, "Archive — thirty years of editorial history", "100vw" %}
        <span class="category-tile-label">Archive</span>
      </a>

    </div>
  </div>
</section>

<!-- ─────────────────────────────────────────
     SECTION 6: ABOUT STRIP
     ───────────────────────────────────────── -->
<section class="about-band">
  <div class="container--narrow">
    <div class="section-label">About Grosby Group</div>
    <h2>THIRTY YEARS AT THE CENTER OF THE STORY</h2>
    <p>Grosby Group is the go-to image agency for Latino media. We connect the world's leading photography agencies with publishers, broadcasters, social media creators, and brands across the US Hispanic market, Latin America, and Brazil</p>
    <a href="/about/" class="btn-ghost">Our story →</a>
  </div>
</section>
