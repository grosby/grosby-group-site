<!-- ─────────────────────────────────────────
     SECTION 3: THREE AUDIENCE PATHS
     ───────────────────────────────────────── -->
<section class="audience-paths">
  <div class="audience-paths-intro">
    <div class="section-label section-label--blue">Who We Serve</div>
    <h2>THE RIGHT CONTENT<br>FOR EVERY AUDIENCE</h2>
  </div>
  <div class="audience-grid">

    <a href="/publishers/" class="audience-card fade-up">
      <div class="audience-card__bg">
        {% image images.hero.publishers, "Copa América football match editorial photography", "(max-width: 900px) 100vw, 33vw" %}
      </div>
      <div class="audience-card__content">
        <p class="audience-card__label">For Publishers &amp; Media Buyers</p>
        <h3>THE CONTENT YOUR AUDIENCE DEMANDS.</h3>
        <p>From breaking celebrity news to archival sports photography, Grosby Group gives Latin American and US Hispanic publishers direct access to the world's most sought-after visual content — cleared, licensed, and delivered on deadline.</p>
        <span class="audience-card-cta">Get Access →</span>
      </div>
    </a>

    <a href="/creators/" class="audience-card fade-up">
      <div class="audience-card__bg">
        {% image images.hero.creators, "Photographer performing on stage with golden stage lights", "(max-width: 900px) 100vw, 33vw" %}
      </div>
      <div class="audience-card__content">
        <p class="audience-card__label">For Photographers &amp; Creators</p>
        <h3>REACH LATIN AMERICA. WE HANDLE THE REST.</h3>
        <p>If your work deserves a Latin American audience, we want to represent you. Thirty years building the relationships and infrastructure to license your content across the region's leading media companies.</p>
        <span class="audience-card-cta">Learn about representation →</span>
      </div>
    </a>

    <a href="/agencies/" class="audience-card fade-up">
      <div class="audience-card__bg">
        {% image images.hero.agencies, "Portrait photography — global image agency partner", "(max-width: 900px) 100vw, 33vw" %}
      </div>
      <div class="audience-card__content">
        <p class="audience-card__label">For Photo Agencies</p>
        <h3>YOUR CONTENT. OUR TERRITORY.</h3>
        <p>Partner with the only agency that has spent three decades building dedicated licensing relationships with Latin America's top publishers. We are the established gateway to this market.</p>
        <span class="audience-card-cta">Partner with us →</span>
      </div>
    </a>

  </div>
</section>

