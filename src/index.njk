<!-- SECTION 3: SERVICES -->
<section class="services">
  <div class="container">
    <div class="section-label section-label--blue">Our Services</div>
    <div class="services-grid">
      <a href="/services/#syndication" class="service-card fade-up">
        <h4>Content Syndication</h4>
        <p>Access millions of editorial images across every category, licensed for publication in print and digital.</p>
        <span class="service-card-cta">Explore content →</span>
      </a>
      <a href="/photographers/" class="service-card fade-up">
        <h4>Photographer Representation</h4>
        <p>We represent and syndicate photographers and agencies worldwide, connecting their work with Latin America's top publishers.</p>
        <span class="service-card-cta">Join our network →</span>
      </a>
      <a href="/services/#production" class="service-card fade-up">
        <h4>Production Services</h4>
        <p>From concept to delivery — we produce original photo and video content for brands and media companies across the region.</p>
        <span class="service-card-cta">Start a project →</span>
      </a>
      <a href="/archive/" class="service-card fade-up">
        <h4>The Archive</h4>
        <p>Thirty years of Latin American visual culture. Thousands of images available exclusively through Grosby Group.</p>
        <span class="service-card-cta">Access the archive →</span>
      </a>
    </div>
  </div>
</section>

<!-- SECTION 4: CONTENT CATEGORIES -->
<section class="categories">
  <div class="container--wide">
    <div class="section-label" style="padding: 0 var(--gutter); max-width: var(--container-max); margin: 0 auto var(--space-3);">Content Library</div>
    <h2 class="categories-heading">EXPLORE THE LIBRARY</h2>
    <div class="categories-grid">
      <a class="category-tile" href="/content/celebrity/">
        {% image images.categories.celebrity, "Celebrity photography — red carpet", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 50vw" %}
        <span class="category-tile-label">Celebrity</span>
      </a>
      <a class="category-tile" href="/content/fashion/">
        {% image images.categories.fashion, "Fashion and street style photography", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw" %}
        <span class="category-tile-label">Fashion</span>
      </a>
      <a class="category-tile" href="/content/sports/">
        {% image images.categories.sports, "Sports photography — football Copa América", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw" %}
        <span class="category-tile-label">Sports</span>
      </a>
      <a class="category-tile" href="/content/travel/">
        {% image images.categories.travel, "Travel photography — Latin America", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw" %}
        <span class="category-tile-label">Travel</span>
      </a>
      <a class="category-tile" href="/content/food/">
        {% image images.categories.food, "Food and recipe photography", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 50vw" %}
        <span class="category-tile-label">Food & Recipes</span>
      </a>
      <a class="category-tile" href="/content/editorial/">
        {% image images.categories.editorial, "Editorial and news photography", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw" %}
        <span class="category-tile-label">Editorial & News</span>
      </a>
      <a class="category-tile" href="/services/#production">
        {% image images.categories.editorial, "Production services — documentary and broadcast", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw" %}
        <span class="category-tile-label">Production</span>
      </a>
      <a class="category-tile" href="/archive/">
        {% image images.categories.archive, "Archive — thirty years of editorial history", "(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw" %}
        <span class="category-tile-label">Archive</span>
      </a>
    </div>
  </div>
</section>

<!-- SECTION 5: ABOUT / CREDIBILITY -->
<section class="about-band">
  <div class="container--narrow">
    <div class="section-label">About Grosby Group</div>
    <h2>THIRTY YEARS AT THE CENTER OF THE STORY</h2>
    <p>Grosby Group is the go-to image agency for Latin America and the US Hispanic market. We represent the world's top photography agencies, licensing their content exclusively to publishers, broadcasters, and brands across the region.</p>
    <a href="/about/" class="btn-ghost">Our story →</a>
  </div>
</section>

<!-- SECTION 6: FOR PUBLISHERS -->
<section class="split-section">
  <div class="split-section__content">
    <div class="section-label">For Publishers & Media Buyers</div>
    <h2>THE CONTENT YOUR AUDIENCE DEMANDS. LICENSED AND READY.</h2>
    <p>From breaking celebrity news to archival sports photography, Grosby Group gives Latin American and US Hispanic publishers direct access to the world's most sought-after visual content — cleared, licensed, and delivered on deadline.</p>
    <a href="{{ site.accountUrl }}" class="btn-primary">Open an account →</a>
  </div>
  <div class="split-section__image split-section__image--placeholder">
    <span>Client to supply image</span>
  </div>
</section>

<!-- SECTION 7: FOR PHOTOGRAPHERS -->
<section class="split-section split-section--reverse split-section--dark">
  <div class="split-section__image split-section__image--placeholder">
    <span>Client to supply image</span>
  </div>
  <div class="split-section__content">
    <div class="section-label">For Photographers & Agencies</div>
    <h2>REACH LATIN AMERICA. WE HANDLE THE REST.</h2>
    <p>If your work deserves a Latin American audience, we want to represent you. Grosby Group has spent thirty years building the relationships and infrastructure to license your content across the region's leading media companies.</p>
    <a href="/contact/" class="btn-ghost">Get in touch →</a>
  </div>
</section>

<!-- SECTION 8: PARTNER AGENCIES -->
<section class="partners">
  <div class="container">
    <div class="section-label section-label--blue">Agencies We Represent</div>
    <h2>THE WORLD'S TOP PHOTO AGENCIES</h2>
    <div class="partners-grid">
      <!-- Placeholder cards — client to supply logos to /assets/partners/ -->
      {% for i in range(0, 18) %}
      <div class="partner-logo partner-logo--placeholder">
        <span style="font-size: 11px; color: var(--color-text-muted); letter-spacing: 0.05em;">Agency logo</span>
      </div>
      {% endfor %}
    </div>
    <p class="partners-closing">Grosby Group exclusively licenses content from the world's leading photography agencies to Latin America and the US Hispanic market's most influential publishers, broadcasters, and brands.</p>
  </div>
</section>
