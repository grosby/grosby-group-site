     SECTION 1: HERO
     ───────────────────────────────────────── -->
<section class="hero">
  <div class="hero-bg">
    {% image images.hero.homepage, "Latin celebrity performing on stage with dramatic lighting", "100vw", "eager" %}
  </div>
  <div class="hero-content">
    <p class="hero-eyebrow">The Image Agency for Latino Media</p>
    <h1 class="hero-headline">WE HAVE IT</h1>
    <p class="hero-subhead">Thirty years. Millions of images. One agency built for the US Hispanic market, Latin America, and Brazil.</p>
    <div class="hero-ctas">
      <a href="{{ site.archiveUrl }}" class="btn-primary" target="_blank" rel="noopener noreferrer">Get Access</a>
      <a href="/contact/" class="btn-ghost">Contact us →</a>
    </div>
  </div>
</section>

